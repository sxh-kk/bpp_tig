# Copy to <external storage>/storage.env and customize for your installation.
# Before sourcing: export BPP_ROOT=/absolute/path/to/external/bpp_storage
# Keep BPP_ROOT outside this Git checkout. No credentials are required here.
: "${BPP_ROOT:?Set BPP_ROOT to an absolute external writable storage directory}"
export BPP_ROOT
export BPP_REPOS_DIR="${BPP_REPOS_DIR:-$BPP_ROOT/repos}"
export TIG_ROOT="${TIG_ROOT:-$BPP_REPOS_DIR/The-Imitator-Game}"
export BPP_BASELINE_DIR="$TIG_ROOT/examples/baselines/bpp"
export BPP_CANONICAL_SOURCE="$BPP_BASELINE_DIR/bpp"
export BPP_WEIGHTS_DIR="$BPP_ROOT/weights"
export BPP_DATA_DIR="$BPP_ROOT/data"
export BPP_RESULTS_DIR="$BPP_ROOT/results"
export BPP_ENVS_DIR="$BPP_ROOT/envs"
export BPP_CHECKPOINT="${BPP_CHECKPOINT:-$BPP_WEIGHTS_DIR/bp_libero/libero_behavior_prompting.ckpt}"
export BPP_RUNTIME_PYTHON="${BPP_RUNTIME_PYTHON:-$BPP_ENVS_DIR/bpp_tig_torch271/bin/python}"
export HF_HOME="$BPP_ROOT/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export TORCH_HOME="$BPP_ROOT/cache/torch"
export XDG_CACHE_HOME="$BPP_ROOT/cache"
export MPLCONFIGDIR="$BPP_ROOT/cache/matplotlib"
export MS_ASSET_DIR="$BPP_ROOT/assets"
export TMPDIR="$BPP_ROOT/tmp"
export PYTHONPATH="$TIG_ROOT:$BPP_REPOS_DIR/behavior_prompting${PYTHONPATH:+:$PYTHONPATH}"
# Create these external directories before installing or running:
# repos weights data results envs cache logs assets tmp
# Never add access tokens, private keys or machine-specific credentials to Git.
